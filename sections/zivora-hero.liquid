{% liquid
  assign fallbacks = 'https://images.unsplash.com/photo-1617038260897-41a1f14a8ca0?w=1800&q=80,https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=1800&q=80,https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?w=1800&q=80' | split: ','
%}

<zivora-slider class="zivora-hero zivora-section" data-interval="6500">
  <div class="zivora-hero__slides">
    {% for block in section.blocks %}
      {% liquid
        assign fallback = fallbacks[forloop.index0] | default: fallbacks.first
        assign image = block.settings.image
      %}
      <div class="zivora-hero__slide{% if forloop.first %} is-active{% endif %}" data-slide {{ block.shopify_attributes }}>
        <div class="zivora-hero__media">
          {% if image != blank %}
            {{ image | image_url: width: 2000 | image_tag: loading: 'eager', widths: '750,1100,1500,2000', sizes: '100vw' }}
          {% else %}
            <img src="{{ fallback }}" alt="{{ block.settings.heading | escape }}" width="1800" height="900">
          {% endif %}
        </div>
        <div class="zivora-hero__content">
          <div class="zivora-wrap">
            <div class="zivora-hero__copy">
              {% if block.settings.kicker != blank %}
                <p class="zivora-kicker">{{ block.settings.kicker }}</p>
              {% endif %}
              {% if block.settings.heading != blank %}
                <h1 class="zivora-heading">{{ block.settings.heading }}</h1>
              {% endif %}
              {% if block.settings.subheading != blank %}
                <p class="zivora-hero__sub">{{ block.settings.subheading }}</p>
              {% endif %}
              {% if block.settings.button_label != blank %}
                <a class="zivora-btn" href="{{ block.settings.button_link | default: routes.all_products_collection_url }}">
                  {{ block.settings.button_label }}
                  <span aria-hidden="true">→</span>
                </a>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>

  {% if section.blocks.size > 1 %}
    <button class="zivora-icon-btn zivora-hero__nav zivora-hero__nav--prev" type="button" data-prev aria-label="Previous slide">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M15 5l-7 7 7 7"/></svg>
    </button>
    <button class="zivora-icon-btn zivora-hero__nav zivora-hero__nav--next" type="button" data-next aria-label="Next slide">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 5l7 7-7 7"/></svg>
    </button>
    <div class="zivora-hero__dots">
      {% for block in section.blocks %}
        <button class="zivora-hero__dot{% if forloop.first %} is-active{% endif %}" type="button" data-dot aria-label="Go to slide {{ forloop.index }}"></button>
      {% endfor %}
    </div>
  {% endif %}
</zivora-slider>

{% schema %}
{
  "name": "Zivora hero",
  "tag": "section",
  "class": "zivora-hero-section",
  "enabled_on": { "templates": ["index"] },
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "kicker", "label": "Kicker", "default": "Timeless Beauty" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Ornaments that Elevate Every You" },
        { "type": "text", "id": "subheading", "label": "Subheading", "default": "Elegant designs. Affordable luxury." },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Zivora hero",
      "blocks": [{ "type": "slide" }, { "type": "slide" }, { "type": "slide" }]
    }
  ]
}
{% endschema %}
