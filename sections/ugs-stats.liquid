{{ 'ugs-theme.css' | asset_url | stylesheet_tag }}

<section class="ugs-page" style="padding-bottom: 20px;">
  <div class="ugs-container">
    <div class="ugs-stats">
      {%- for block in section.blocks -%}
        {%- liquid
          if block.settings.image != blank
            assign media_src = block.settings.image | image_url: width: 400
          else
            assign asset_name = block.settings.image_asset
            if asset_name == blank
              case forloop.index
                when 1
                  assign asset_name = 'ugs-stat-experience.jpg'
                when 2
                  assign asset_name = 'ugs-stat-projects-5ee16a.jpg'
                else
                  assign asset_name = 'ugs-stat-brands.jpg'
              endcase
            endif
            capture media_src
              render 'ugs-asset', name: asset_name
            endcapture
            assign media_src = media_src | strip
          endif
        -%}
        <article class="ugs-stat-card" {{ block.shopify_attributes }}>
          {%- if media_src != blank -%}
            <img class="ugs-stat-card__media" src="{{ media_src }}" alt="{{ block.settings.label | escape }}" width="160" height="280" loading="lazy">
          {%- endif -%}
          <div class="ugs-stat-card__body">
            <span class="ugs-stat-card__bar" aria-hidden="true"></span>
            <div>
              <p class="ugs-stat-card__value">{{ block.settings.value }}</p>
              <p class="ugs-stat-card__label">{{ block.settings.label }}</p>
            </div>
            <p class="ugs-stat-card__desc">{{ block.settings.description }}</p>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "UGS Stats",
  "tag": "section",
  "class": "ugs-page",
  "max_blocks": 3,
  "settings": [],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Theme image filename"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "5+"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Years of Experience"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Delivering Reliable Solar Solutions"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "UGS Stats",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "value": "5+",
            "label": "Years of Experience",
            "description": "Delivering Reliable Solar Solutions",
            "image_asset": "ugs-stat-experience.jpg"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "5000+",
            "label": "Projects Delivered",
            "description": "Across Residential & Commercial Sectors",
            "image_asset": "ugs-stat-projects-5ee16a.jpg"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "50+",
            "label": "Trusted Brands",
            "description": "From Leading Global Manufacturers",
            "image_asset": "ugs-stat-brands.jpg"
          }
        }
      ]
    }
  ]
}
{% endschema %}
