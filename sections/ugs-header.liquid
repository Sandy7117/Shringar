{{ 'ugs-theme.css' | asset_url | stylesheet_tag }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700&family=Montserrat:wght@500;600;700&display=swap" rel="stylesheet">

<header class="ugs-page">
  <div class="ugs-header-top">
    <a class="ugs-header-top__logo" href="{{ routes.root_url }}">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 366 | image_tag: loading: 'eager', alt: shop.name }}
      {%- elsif section.settings.logo_asset != blank -%}
        <img src="{{ section.settings.logo_asset | asset_url }}" alt="{{ shop.name | escape }}" width="183" height="90">
      {%- else -%}
        <img src="{{ 'ugs-logo.svg' | asset_url }}" alt="{{ shop.name | escape }}" width="183" height="90">
      {%- endif -%}
    </a>

    {%- if section.settings.show_search -%}
      <form class="ugs-header-search" action="{{ routes.search_url }}" method="get" role="search">
        <input type="search" name="q" placeholder="{{ section.settings.search_placeholder | escape }}" aria-label="Search">
        <button type="submit" aria-label="Search">
          <img src="{{ 'ugs-icon-search.svg' | asset_url }}" alt="" width="28" height="28">
        </button>
      </form>
    {%- endif -%}

    <div class="ugs-header-actions">
      {%- if section.settings.phone_label != blank -%}
        <p class="ugs-header-actions__label">{{ section.settings.phone_label }}</p>
      {%- endif -%}
      {%- if section.settings.phone != blank -%}
        <a class="ugs-header-actions__phone" href="tel:{{ section.settings.phone | replace: ' ', '' | replace: '-', '' }}">
          {{ section.settings.phone }}
        </a>
      {%- endif -%}
      <div class="ugs-header-actions__links">
        <a href="{{ routes.account_url }}">
          <img src="{{ 'ugs-icon-user.svg' | asset_url }}" alt="" width="20" height="20">
          {{ section.settings.account_label }}
        </a>
        <a href="{{ routes.cart_url }}">
          <img src="{{ 'ugs-icon-cart.svg' | asset_url }}" alt="" width="20" height="20">
          {{ section.settings.cart_label }}
          {%- if cart.item_count > 0 -%} ({{ cart.item_count }}){%- endif -%}
        </a>
      </div>
    </div>
  </div>

  <nav class="ugs-nav" id="UgsNav-{{ section.id }}" aria-label="Primary">
    <button type="button" class="ugs-nav__mobile-toggle" data-ugs-nav-toggle aria-expanded="false">Menu</button>
    <div class="ugs-nav__list">
      {%- if section.settings.menu != blank -%}
        {%- for link in section.settings.menu.links -%}
          {%- if link.links != blank -%}
            <details>
              <summary>
                {{ link.title }}
                <img src="{{ 'ugs-icon-caret.svg' | asset_url }}" alt="" width="20" height="20">
              </summary>
              <div class="ugs-nav__dropdown">
                {%- for child in link.links -%}
                  <a href="{{ child.url }}">{{ child.title }}</a>
                {%- endfor -%}
              </div>
            </details>
          {%- else -%}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- assign fallback_items = 'Solar Panels,Inverters,Batteries,Lighting,Mounting Systems,EV Chargers,Solar Kits,Accessories' | split: ',' -%}
        {%- for item in fallback_items -%}
          <a href="{{ routes.all_products_collection_url }}">
            {{ item }}
            <img src="{{ 'ugs-icon-caret.svg' | asset_url }}" alt="" width="20" height="20">
          </a>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </nav>
</header>

<script>
  (function () {
    var nav = document.getElementById('UgsNav-{{ section.id }}');
    if (!nav) return;
    var toggle = nav.querySelector('[data-ugs-nav-toggle]');
    if (!toggle) return;
    toggle.addEventListener('click', function () {
      var open = nav.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  })();
</script>

{% schema %}
{
  "name": "UGS Header",
  "tag": "section",
  "class": "ugs-page",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "logo_asset",
      "label": "Theme logo filename",
      "default": "ugs-logo.svg"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search",
      "default": true
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Search for over 15000+ products"
    },
    {
      "type": "text",
      "id": "phone_label",
      "label": "Phone label",
      "default": "To Speak to a U.S. Based Solar Expert"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone number",
      "default": "1-332-291-6885"
    },
    {
      "type": "text",
      "id": "account_label",
      "label": "Account label",
      "default": "Login / Register"
    },
    {
      "type": "text",
      "id": "cart_label",
      "label": "Cart label",
      "default": "Cart"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
