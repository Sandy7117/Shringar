<div class="zivora-usps zivora-section">
  <div class="zivora-wrap zivora-usps__grid">
    {% for block in section.blocks %}
      <article class="zivora-usp" {{ block.shopify_attributes }}>
        {% case block.settings.icon %}
          {% when 'quality' %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="12" cy="12" r="8"/><path d="M12 8v4l2.5 1.5"/></svg>
          {% when 'price' %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 3v18M8 8.5c0-1.7 1.8-3 4-3s4 1.3 4 3-1.8 3-4 3-4 1.3-4 3 1.8 3 4 3 4-1.3 4-3"/></svg>
          {% when 'pack' %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M4 8l8-4 8 4v8l-8 4-8-4V8z"/><path d="M12 12l8-4M12 12v8M12 12L4 8"/></svg>
          {% else %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 21s-7-4.4-7-10a4 4 0 017-2.6A4 4 0 0119 11c0 5.6-7 10-7 10z"/></svg>
        {% endcase %}
        <div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      </article>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Zivora trust bar",
  "tag": "section",
  "class": "zivora-usps-section",
  "enabled_on": { "templates": ["index"] },
  "settings": [],
  "blocks": [
    {
      "type": "usp",
      "name": "USP",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "quality", "label": "Quality" },
            { "value": "price", "label": "Price" },
            { "value": "pack", "label": "Packaging" },
            { "value": "trust", "label": "Trust" }
          ],
          "default": "quality"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Premium Quality" },
        { "type": "text", "id": "text", "label": "Text", "default": "Skin-friendly & durable." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Zivora trust bar",
      "blocks": [
        { "type": "usp", "settings": { "icon": "quality", "title": "Premium Quality", "text": "Skin-friendly & durable." } },
        { "type": "usp", "settings": { "icon": "price", "title": "Affordable Prices", "text": "Luxury looks, budget friendly." } },
        { "type": "usp", "settings": { "icon": "pack", "title": "Secure Packaging", "text": "Perfectly packed for you." } },
        { "type": "usp", "settings": { "icon": "trust", "title": "Trusted by 10K+", "text": "Happy customers across India." } }
      ]
    }
  ]
}
{% endschema %}
