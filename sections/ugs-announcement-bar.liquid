{{ 'ugs-theme.css' | asset_url | stylesheet_tag }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700&family=Montserrat:wght@500;600;700&display=swap" rel="stylesheet">

{%- unless section.settings.enabled == false -%}
  <div class="ugs-announce" id="UgsAnnounce-{{ section.id }}" role="region" aria-label="Announcement">
    <p class="ugs-announce__text">
      {%- if section.settings.highlight_text != blank -%}
        <span class="ugs-accent">{{ section.settings.highlight_text }}</span>
      {%- endif -%}
      {{ section.settings.text }}
      {%- if section.settings.highlight_text_2 != blank -%}
        <span class="ugs-accent">{{ section.settings.highlight_text_2 }}</span>
      {%- endif -%}
      {{ section.settings.text_2 }}
    </p>
    {%- if section.settings.show_close -%}
      <button type="button" class="ugs-announce__close" aria-label="Close announcement" data-ugs-announce-close>&times;</button>
    {%- endif -%}
  </div>
  <script>
    (function () {
      var root = document.getElementById('UgsAnnounce-{{ section.id }}');
      if (!root) return;
      var key = 'ugs-announce-closed';
      if (sessionStorage.getItem(key) === '1') root.classList.add('is-hidden');
      var btn = root.querySelector('[data-ugs-announce-close]');
      if (btn) {
        btn.addEventListener('click', function () {
          root.classList.add('is-hidden');
          sessionStorage.setItem(key, '1');
        });
      }
    })();
  </script>
{%- endunless -%}

{% schema %}
{
  "name": "UGS Announcement",
  "tag": "section",
  "class": "ugs-page",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Show announcement",
      "default": true
    },
    {
      "type": "text",
      "id": "highlight_text",
      "label": "Highlight text",
      "default": "FREE SHIPPING"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": " ON ALL ORDERS ABOVE $600 | "
    },
    {
      "type": "text",
      "id": "highlight_text_2",
      "label": "Second highlight",
      "default": "CALL US"
    },
    {
      "type": "text",
      "id": "text_2",
      "label": "Trailing text",
      "default": " WITH ANY QUESTIONS"
    },
    {
      "type": "checkbox",
      "id": "show_close",
      "label": "Show close button",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "UGS Announcement"
    }
  ]
}
{% endschema %}
