{% liquid
  assign defaults = 'Earrings|https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?w=400&q=80,Necklaces|https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=400&q=80,Pendants|https://images.unsplash.com/photo-1611652022419-a73b6dce8930?w=400&q=80,Nose Rings|https://images.unsplash.com/photo-1603561591413-0471c05a3ff8?w=400&q=80,Rings|https://images.unsplash.com/photo-1605100804763-247f67b3557e?w=400&q=80,Bangles|https://images.unsplash.com/photo-1611591437281-460bfbe1220a?w=400&q=80,Sets|https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?w=400&q=80,Hair Accessories|https://images.unsplash.com/photo-1450297166380-cabe503887e5?w=400&q=80' | split: ','
%}

<zivora-scroller class="zivora-cats zivora-section">
  <div class="zivora-wrap zivora-cats__row">
    <div class="zivora-cats__scroller" data-scroller>
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <a class="zivora-cat" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
            <div class="zivora-cat__img">
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 300 | image_tag: loading: 'lazy', widths: '150,300' }}
              {% else %}
                {% assign fallback = defaults[forloop.index0] | default: defaults.first | split: '|' %}
                <img src="{{ fallback[1] }}" alt="{{ block.settings.title | escape }}" width="216" height="216" loading="lazy">
              {% endif %}
            </div>
            <span class="zivora-cat__label">{{ block.settings.title }}</span>
          </a>
        {% endfor %}
      {% else %}
        {% for item in defaults %}
          {% assign parts = item | split: '|' %}
          <a class="zivora-cat" href="{{ routes.all_products_collection_url }}">
            <div class="zivora-cat__img">
              <img src="{{ parts[1] }}" alt="{{ parts[0] | escape }}" width="216" height="216" loading="lazy">
            </div>
            <span class="zivora-cat__label">{{ parts[0] }}</span>
          </a>
        {% endfor %}
      {% endif %}
    </div>
    <button class="zivora-cats__next" type="button" data-next aria-label="Scroll categories">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 5l7 7-7 7"/></svg>
    </button>
  </div>
</zivora-scroller>

{% schema %}
{
  "name": "Zivora categories",
  "tag": "section",
  "class": "zivora-cats-section",
  "enabled_on": { "templates": ["index"] },
  "settings": [],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Earrings" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Zivora categories",
      "blocks": [
        { "type": "category", "settings": { "title": "Earrings" } },
        { "type": "category", "settings": { "title": "Necklaces" } },
        { "type": "category", "settings": { "title": "Pendants" } },
        { "type": "category", "settings": { "title": "Nose Rings" } },
        { "type": "category", "settings": { "title": "Rings" } },
        { "type": "category", "settings": { "title": "Bangles" } },
        { "type": "category", "settings": { "title": "Sets" } },
        { "type": "category", "settings": { "title": "Hair Accessories" } }
      ]
    }
  ]
}
{% endschema %}
