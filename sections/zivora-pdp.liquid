{% liquid
  assign product = product | default: closest.product
  assign variant = product.selected_or_first_available_variant
  assign compare = variant.compare_at_price
  assign price = variant.price
  assign save = 0
  if compare > price and compare > 0
    assign save = compare | minus: price | times: 100.0 | divided_by: compare | round
  endif

  assign collection_parent = collection | default: product.collections.first
  assign tagline = product.metafields.custom.tagline | default: section.settings.tagline
  assign rating = product.metafields.reviews.rating.value | default: section.settings.rating
  assign rating_count = product.metafields.reviews.rating_count | default: section.settings.rating_count
  assign show_badge = section.settings.show_badge
  if product.tags contains 'bestseller' or product.tags contains 'Best Seller'
    assign show_badge = true
  endif

  assign can_add_to_cart = false
  if variant.available
    assign can_add_to_cart = true
    assign add_to_cart_text = 'products.product.add_to_cart' | t
  else
    assign add_to_cart_text = 'products.product.sold_out' | t
  endif
%}

{% render 'quantity-selector-styles' %}
{% render 'add-to-cart-button-styles' %}

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

<zivora-pdp class="zivora-section zivora-pdp">
  <script type="application/json" data-variants-json>
    [
      {%- for v in product.variants -%}
        {
          "id": {{ v.id }},
          "options": {{ v.options | json }},
          "available": {{ v.available }},
          "price": {{ v.price | money | json }},
          "compare": {% if v.compare_at_price > v.price %}{{ v.compare_at_price | money | json }}{% else %}""{% endif %},
          "save": {% if v.compare_at_price > v.price %}"{{ v.compare_at_price | minus: v.price | times: 100.0 | divided_by: v.compare_at_price | round }}% OFF"{% else %}""{% endif %},
          "image": {% if v.featured_image %}{{ v.featured_image | image_url: width: 1400 | json }}{% else %}null{% endif %}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>

  <div class="zivora-wrap zivora-pdp__grid">
    <div class="zivora-pdp__thumbs">
      {% if product.media.size > 0 %}
        {% for media in product.media %}
          <button
            type="button"
            class="zivora-pdp__thumb{% if forloop.first %} is-active{% endif %}"
            data-thumb
            data-full="{{ media.preview_image | image_url: width: 1400 }}"
            aria-label="View media {{ forloop.index }}"
          >
            {{ media.preview_image | image_url: width: 200 | image_tag: loading: 'lazy', widths: '86,172' }}
            {% if media.media_type == 'video' or media.media_type == 'external_video' %}
              <span class="zivora-pdp__play" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
              </span>
            {% endif %}
          </button>
        {% endfor %}
      {% else %}
        {% for i in (1..4) %}
          <button type="button" class="zivora-pdp__thumb{% if forloop.first %} is-active{% endif %}" data-thumb data-full="https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?w=1400&q=80">
            <img src="https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?w=200&q=80" alt="" width="86" height="86">
          </button>
        {% endfor %}
      {% endif %}
    </div>

    <div class="zivora-pdp__main">
      {% if show_badge %}
        <span class="zivora-pdp__badge">{{ section.settings.badge_text }}</span>
      {% endif %}
      {% if product.featured_image %}
        <img
          data-main-image
          src="{{ product.featured_image | image_url: width: 1200 }}"
          alt="{{ product.featured_image.alt | default: product.title | escape }}"
          width="1200"
          height="1200"
        >
      {% else %}
        <img data-main-image src="https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?w=1400&q=80" alt="{{ product.title | escape }}" width="1200" height="1200">
      {% endif %}
      <button class="zivora-pdp__zoom" type="button" data-zoom aria-label="Zoom image">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3-3M11 8v6M8 11h6"/></svg>
      </button>
    </div>

    <div class="zivora-pdp__info">
      <div class="zivora-pdp__top">
        <nav class="zivora-pdp__crumbs" aria-label="Breadcrumb">
          <a href="{{ routes.root_url }}">Home</a>
          {% if collection_parent %}
            <span> › </span>
            <a href="{{ collection_parent.url }}">{{ collection_parent.title }}</a>
          {% endif %}
          <span> › </span>
          <span>{{ product.title }}</span>
        </nav>
        <button class="zivora-pdp__heart" type="button" aria-label="Add to wishlist">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 21s-7-4.4-7-10a4.2 4.2 0 017-2.5A4.2 4.2 0 0119 11c0 5.6-7 10-7 10z"/></svg>
        </button>
      </div>

      <h1 class="zivora-pdp__title">{{ product.title }}</h1>
      {% if tagline != blank %}
        <p class="zivora-pdp__tagline">{{ tagline }}</p>
      {% endif %}

      <div class="zivora-pdp__rating">
        <span class="zivora-pdp__stars" aria-hidden="true">★★★★★</span>
        <span>{{ rating }} ({{ rating_count }} reviews)</span>
      </div>

      <div class="zivora-pdp__price">
        <span class="zivora-pdp__price-now" data-price-now>{{ price | money }}</span>
        {% if compare > price %}
          <span class="zivora-pdp__price-was" data-price-was>{{ compare | money }}</span>
          <span class="zivora-pdp__price-off" data-price-off>{{ save }}% OFF</span>
        {% else %}
          <span class="zivora-pdp__price-was" data-price-was hidden></span>
          <span class="zivora-pdp__price-off" data-price-off hidden></span>
        {% endif %}
      </div>

      <div class="zivora-pdp__features">
        <div class="zivora-pdp__feature">
          <span class="zivora-pdp__feature-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 3l2.2 6.6H21l-5.4 4 2.1 6.4L12 16.8 6.3 20l2.1-6.4L3 9.6h6.8z"/></svg>
          </span>
          Premium Quality
        </div>
        <div class="zivora-pdp__feature">
          <span class="zivora-pdp__feature-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 3v18M7 8h7a3 3 0 010 6H9"/></svg>
          </span>
          Anti Tarnish
        </div>
        <div class="zivora-pdp__feature">
          <span class="zivora-pdp__feature-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 21s-7-4.4-7-10a4 4 0 017-2.6A4 4 0 0119 11c0 5.6-7 10-7 10z"/></svg>
          </span>
          Skin Friendly
        </div>
      </div>

      <product-form-component
        data-section-id="{{ section.id }}"
        data-product-id="{{ product.id }}"
        data-product-url="{{ product.url }}"
        on:submit="/handleSubmit"
        data-quantity-default="{{ variant.quantity_rule.min | default: 1 }}"
      >
        <div class="visually-hidden" aria-live="assertive" role="status" aria-atomic="true" ref="liveRegion"></div>
        {% form 'product', product, id: 'ZivoraProductForm', data-type: 'add-to-cart-form' %}
          <input type="hidden" name="id" ref="variantId" data-variant-id value="{{ variant.id }}">

          {% unless product.has_only_default_variant %}
            {% for option in product.options_with_values %}
              {% liquid
                assign option_key = option.name | downcase
                assign is_color = false
                if option_key contains 'color' or option_key contains 'colour'
                  assign is_color = true
                endif
              %}
              <div class="zivora-pdp__option" data-option-name="{{ option.name | escape }}">
                <span class="zivora-pdp__option-label">
                  {{ option.name }}{% if is_color %}: <span data-color-label>{{ option.selected_value }}</span>{% endif %}
                </span>
                {% if is_color %}
                  <div class="zivora-pdp__swatches">
                    {% for value in option.values %}
                      {% liquid
                        assign swatch = '#c4a36a'
                        assign value_key = value | downcase
                        if value_key contains 'silver' or value_key contains 'white'
                          assign swatch = '#c9c4bb'
                        elsif value_key contains 'rose'
                          assign swatch = '#b76e79'
                        elsif value_key contains 'black'
                          assign swatch = '#1c1917'
                        endif
                      %}
                      <button
                        type="button"
                        class="zivora-pdp__swatch{% if value == option.selected_value %} is-active{% endif %}"
                        data-option
                        data-value="{{ value | escape }}"
                        style="background: {{ swatch }}"
                        aria-label="{{ value | escape }}"
                      ></button>
                    {% endfor %}
                  </div>
                {% else %}
                  <div class="zivora-pdp__pills">
                    {% for value in option.values %}
                      <button
                        type="button"
                        class="zivora-pdp__pill{% if value == option.selected_value %} is-active{% endif %}"
                        data-option
                        data-value="{{ value | escape }}"
                      >
                        {{ value }}
                      </button>
                    {% endfor %}
                  </div>
                {% endif %}
              </div>
            {% endfor %}
          {% else %}
            <div class="zivora-pdp__option">
              <span class="zivora-pdp__option-label">Color: <span data-color-label>{{ section.settings.default_color }}</span></span>
              <div class="zivora-pdp__swatches">
                <button type="button" class="zivora-pdp__swatch is-active" style="background: #c4a36a" aria-label="{{ section.settings.default_color }}"></button>
              </div>
            </div>
          {% endunless %}

          <div class="zivora-pdp__option">
            <span class="zivora-pdp__qty-label">Quantity:</span>
            {% render 'quantity-selector', product: product %}
          </div>

          <div class="zivora-pdp__actions">
            {% render 'add-to-cart-button',
              id: 'ZivoraAddToCart',
              class: 'zivora-btn add-to-cart-button',
              can_add_to_cart: can_add_to_cart,
              show_icon: false,
              product: product,
              add_to_cart_text: add_to_cart_text
            %}
            <button class="zivora-btn zivora-pdp__buynow" type="button" data-buy-now>Buy It Now</button>
          </div>
        {% endform %}
      </product-form-component>

      <div class="zivora-pdp__trust">
        <div class="zivora-pdp__trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="3" y="7" width="18" height="12" rx="2"/><path d="M7 7V5a5 5 0 0110 0v2"/></svg>
          Cash on Delivery
        </div>
        <div class="zivora-pdp__trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M3 12a9 9 0 101.6-5.2"/><path d="M3 4v5h5"/></svg>
          7-Day Easy Returns
        </div>
        <div class="zivora-pdp__trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="2" y="7" width="20" height="12" rx="2"/><path d="M16 7V6a4 4 0 00-8 0v1"/></svg>
          Free Shipping above ₹999
        </div>
      </div>
    </div>
  </div>

  <div class="zivora-pdp-usps">
    <div class="zivora-wrap zivora-pdp-usps__grid">
      {% for block in section.blocks %}
        {% if block.type == 'usp' %}
          <article {{ block.shopify_attributes }}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="12" cy="12" r="8"/><path d="M8 12l2.5 2.5L16 9"/></svg>
            <div>
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <div class="zivora-wrap zivora-pdp-details">
    <div class="zivora-pdp-details__grid">
      <div>
        <details class="zivora-pdp-acc" open>
          <summary>
            Product Details
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 9l6 6 6-6"/></svg>
          </summary>
          <dl class="zivora-pdp-specs">
            {% for block in section.blocks %}
              {% if block.type == 'spec' %}
                <dt {{ block.shopify_attributes }}>{{ block.settings.label }}</dt>
                <dd>{{ block.settings.value }}</dd>
              {% endif %}
            {% endfor %}
          </dl>
        </details>
        <details class="zivora-pdp-acc">
          <summary>
            Shipping & Returns
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 9l6 6 6-6"/></svg>
          </summary>
          <div class="zivora-pdp-acc__body">{{ section.settings.shipping_text }}</div>
        </details>
        <details class="zivora-pdp-acc">
          <summary>
            Care Instructions
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 9l6 6 6-6"/></svg>
          </summary>
          <div class="zivora-pdp-acc__body">{{ section.settings.care_text }}</div>
        </details>
      </div>

      <div class="zivora-pdp-inspo">
        <h2>Styling Inspiration</h2>
        <div class="zivora-pdp-inspo__grid">
          {% for i in (1..3) %}
            {% liquid
              assign inspo = nil
              if i == 1
                assign inspo = section.settings.inspo_1
              elsif i == 2
                assign inspo = section.settings.inspo_2
              else
                assign inspo = section.settings.inspo_3
              endif
            %}
            {% if inspo != blank %}
              {{ inspo | image_url: width: 700 | image_tag: loading: 'lazy' }}
            {% elsif product.media.size > i %}
              {{ product.media[i].preview_image | image_url: width: 700 | image_tag: loading: 'lazy' }}
            {% else %}
              <img src="https://images.unsplash.com/photo-1617038260897-41a1f14a8ca0?w=700&q=80" alt="" width="400" height="520" loading="lazy">
            {% endif %}
          {% endfor %}
        </div>
        <p>{{ section.settings.inspo_caption }}</p>
      </div>
    </div>
  </div>

  {% liquid
    assign related_source = section.settings.related_collection | default: product.collections.first
    assign related_count = 0
  %}
  <zivora-scroller class="zivora-wrap zivora-pdp-related">
    <div class="zivora-pdp-related__head">
      <h2>You May Also Like</h2>
      <button class="zivora-icon-btn" type="button" data-next aria-label="See more products">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 5l7 7-7 7"/></svg>
      </button>
    </div>
    <div class="zivora-pdp-related__track" data-scroller>
      {% if related_source != blank %}
        {% for related in related_source.products %}
          {% if related.id != product.id %}
          {% assign related_count = related_count | plus: 1 %}
          {% if related_count <= 4 %}
          <article class="zivora-card">
            <div class="zivora-card__media">
              <a href="{{ related.url }}">
                {% if related.featured_image %}
                  {{ related.featured_image | image_url: width: 700 | image_tag: loading: 'lazy' }}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag }}
                {% endif %}
              </a>
            </div>
            <a class="zivora-card__title" href="{{ related.url }}">{{ related.title }}</a>
            <div class="zivora-card__meta">
              <span class="zivora-price__now">{{ related.price | money }}</span>
              <span class="zivora-card__stars">★ 4.7</span>
            </div>
          </article>
          {% endif %}
          {% endif %}
        {% endfor %}
      {% endif %}
      {% if related_count == 0 %}
        {% assign placeholders = 'Luxe Baguette Huggies|749,Aurelia Pearl Drops|899,Noir Hoop Earrings|649,Celeste Stud Pair|799' | split: ',' %}
        {% for item in placeholders %}
          {% assign parts = item | split: '|' %}
          <article class="zivora-card">
            <div class="zivora-card__media">
              <img src="https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?w=700&q=80" alt="{{ parts[0] | escape }}" width="400" height="400" loading="lazy">
            </div>
            <span class="zivora-card__title">{{ parts[0] }}</span>
            <div class="zivora-card__meta">
              <span class="zivora-price__now">₹{{ parts[1] }}</span>
              <span class="zivora-card__stars">★ 4.7</span>
            </div>
          </article>
        {% endfor %}
      {% endif %}
    </div>
  </zivora-scroller>

  <div class="zivora-lightbox" data-lightbox>
    <button type="button" data-lightbox-close aria-label="Close">×</button>
    <img data-lightbox-image alt="{{ product.title | escape }}">
  </div>
</zivora-pdp>

{% schema %}
{
  "name": "Zivora product page",
  "tag": "section",
  "class": "zivora-pdp-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "checkbox", "id": "show_badge", "label": "Show badge", "default": true },
    { "type": "text", "id": "badge_text", "label": "Badge text", "default": "BEST SELLER" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Minimal sparkle. Maximum elegance." },
    { "type": "text", "id": "rating", "label": "Rating", "default": "4.8" },
    { "type": "text", "id": "rating_count", "label": "Review count", "default": "256" },
    { "type": "text", "id": "default_color", "label": "Default color label", "default": "Gold" },
    { "type": "textarea", "id": "shipping_text", "label": "Shipping & returns", "default": "Orders ship within 2–4 business days. Easy 7-day returns on unused pieces in original packaging. Free shipping on orders above ₹999." },
    { "type": "textarea", "id": "care_text", "label": "Care instructions", "default": "Avoid perfume and moisture on the piece. Wipe with a soft dry cloth after wear and store in the pouch provided." },
    { "type": "image_picker", "id": "inspo_1", "label": "Inspiration image 1" },
    { "type": "image_picker", "id": "inspo_2", "label": "Inspiration image 2" },
    { "type": "image_picker", "id": "inspo_3", "label": "Inspiration image 3" },
    { "type": "text", "id": "inspo_caption", "label": "Inspiration caption", "default": "Effortless sparkle for everyday looks." },
    { "type": "collection", "id": "related_collection", "label": "You may also like collection" }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "USP",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Anti Tarnish" },
        { "type": "text", "id": "text", "label": "Text", "default": "Long lasting shine that stays with you." }
      ]
    },
    {
      "type": "spec",
      "name": "Spec",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Type" },
        { "type": "text", "id": "value", "label": "Value", "default": "Huggie Earrings" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Zivora product page",
      "blocks": [
        { "type": "usp", "settings": { "title": "Anti Tarnish", "text": "Long lasting shine that stays with you." } },
        { "type": "usp", "settings": { "title": "Water Resistant", "text": "Wear it worry-free, everyday." } },
        { "type": "usp", "settings": { "title": "Premium Finish", "text": "Crafted with fine detail and care." } },
        { "type": "usp", "settings": { "title": "Skin Friendly", "text": "Nickel free and gentle on your skin." } },
        { "type": "spec", "settings": { "label": "Type", "value": "Huggie Earrings" } },
        { "type": "spec", "settings": { "label": "Material", "value": "18K Gold Plated Stainless Steel" } },
        { "type": "spec", "settings": { "label": "Stone", "value": "AAA+ Cubic Zirconia" } },
        { "type": "spec", "settings": { "label": "Closure", "value": "Hinged Click-Top" } },
        { "type": "spec", "settings": { "label": "Weight", "value": "2.5g Pair" } },
        { "type": "spec", "settings": { "label": "Size", "value": "15 mm Diameter" } }
      ]
    }
  ]
}
{% endschema %}
