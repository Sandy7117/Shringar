{{ 'ugs-theme.css' | asset_url | stylesheet_tag }}

{%- liquid
  if section.settings.image != blank
    assign bg_src = section.settings.image | image_url: width: 2400
  else
    assign asset_name = section.settings.image_asset | default: 'ugs-wholesale-banner.jpg'
    capture bg_src
      render 'ugs-asset', name: asset_name
    endcapture
    assign bg_src = bg_src | strip
  endif
-%}

<section class="ugs-page" style="padding-bottom: 40px;">
  <div class="ugs-container">
    <div class="ugs-wholesale">
      {%- if bg_src != blank -%}
        <img class="ugs-wholesale__bg" src="{{ bg_src }}" alt="" width="1240" height="200" loading="lazy">
      {%- endif -%}
      <div class="ugs-wholesale__overlay"></div>
      <div class="ugs-wholesale__inner">
        <div class="ugs-wholesale__copy">
          {%- if section.settings.heading != blank -%}
            <h2 class="ugs-heading ugs-h1">{{ section.settings.heading }}</h2>
          {%- endif -%}
          {%- if section.settings.subheading != blank or section.settings.highlight != blank -%}
            <p class="ugs-heading ugs-h3">
              {{ section.settings.subheading }}
              {%- if section.settings.highlight != blank -%}
                <span class="ugs-accent">{{ section.settings.highlight }}</span>
              {%- endif -%}
            </p>
          {%- endif -%}
        </div>
        <div class="ugs-wholesale__actions">
          {%- if section.settings.button_label != blank -%}
            <a class="ugs-btn ugs-btn--outline" href="{{ section.settings.button_link | default: '#' }}">
              {{ section.settings.button_label }}
              <img src="{{ 'ugs-icon-arrow-right.svg' | asset_url }}" alt="" width="28" height="28">
            </a>
          {%- endif -%}
          {%- if section.settings.phone != blank -%}
            <p class="ugs-wholesale__phone">
              Call <strong>{{ section.settings.phone }}</strong>
            </p>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "UGS Wholesale CTA",
  "tag": "section",
  "class": "ugs-page",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "image_asset",
      "label": "Theme image filename",
      "default": "ugs-wholesale-banner.jpg"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get the Right Solar Products"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "At Competitive "
    },
    {
      "type": "text",
      "id": "highlight",
      "label": "Highlighted text",
      "default": "Wholesale Prices!"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Contact a Specialist"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone",
      "default": "1-332-916-885"
    }
  ],
  "presets": [
    {
      "name": "UGS Wholesale CTA"
    }
  ]
}
{% endschema %}
