{{ 'ugs-theme.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign default_icons = 'ugs-icon-truck.svg,ugs-icon-trophy.svg,ugs-icon-tag.svg,ugs-icon-shield.svg,ugs-icon-globe.svg,ugs-icon-headset.svg' | split: ','
-%}

<section class="ugs-trust-wrap ugs-page">
  <div class="ugs-trust-card">
    {%- if section.settings.title != blank -%}
      <h2 class="ugs-heading ugs-h2 ugs-trust-card__title">{{ section.settings.title }}</h2>
    {%- endif -%}
    <div class="ugs-trust-card__row">
      <div class="ugs-trust-card__copy">
        {%- if section.settings.body_html != blank -%}
          {{ section.settings.body_html }}
        {%- else -%}
          {{ section.settings.body | newline_to_br }}
        {%- endif -%}
      </div>
      <div class="ugs-trust-grid">
        {%- for block in section.blocks -%}
          {%- liquid
            if block.settings.icon != blank
              assign icon_src = block.settings.icon | image_url: width: 128
            else
              assign icon_name = block.settings.icon_asset | default: default_icons[forloop.index0]
              capture icon_src
                render 'ugs-asset', name: icon_name
              endcapture
              assign icon_src = icon_src | strip
            endif
          -%}
          <div class="ugs-trust-feature" {{ block.shopify_attributes }}>
            {%- if icon_src != blank -%}
              <img src="{{ icon_src }}" alt="" width="64" height="64" loading="lazy">
            {%- endif -%}
            <p>
              {%- if block.settings.highlight != blank -%}
                <strong>{{ block.settings.highlight }}</strong>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                {{ block.settings.text | newline_to_br }}
              {%- endif -%}
            </p>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "UGS Trust",
  "tag": "section",
  "class": "ugs-page",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Why Customers Trust Us"
    },
    {
      "type": "richtext",
      "id": "body_html",
      "label": "Body (rich text)",
      "default": "<p>We're more than a solar supplier, we're your <strong>trusted project partner.</strong></p><p>Whether you're purchasing a single system or sourcing products for large-scale installations, we deliver premium brands, reliable inventory, nationwide distribution, and dedicated technical support to keep your projects moving.</p>"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body fallback",
      "default": "We're more than a solar supplier, we're your trusted project partner.\n\nWhether you're purchasing a single system or sourcing products for large-scale installations, we deliver premium brands, reliable inventory, nationwide distribution, and dedicated technical support to keep your projects moving."
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "icon_asset",
          "label": "Theme icon filename"
        },
        {
          "type": "text",
          "id": "highlight",
          "label": "Highlighted phrase"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Remaining text",
          "default": " across the United States."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "UGS Trust",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon_asset": "ugs-icon-truck.svg",
            "highlight": "Fast delivery",
            "text": " across\nthe United States."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon_asset": "ugs-icon-trophy.svg",
            "highlight": "Tier-1 products",
            "text": "\nfrom trusted brands."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon_asset": "ugs-icon-tag.svg",
            "highlight": "Better pricing",
            "text": "\non large orders."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon_asset": "ugs-icon-shield.svg",
            "highlight": "Warranty coverage",
            "text": "\nyou can trust"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon_asset": "ugs-icon-globe.svg",
            "highlight": "",
            "text": "Reliable shipping\nacross the USA."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon_asset": "ugs-icon-headset.svg",
            "highlight": "Expert support",
            "text": "\npre- & post-sales."
          }
        }
      ]
    }
  ]
}
{% endschema %}
