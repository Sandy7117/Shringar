<section class="zivora-promos zivora-section">
  <div class="zivora-wrap zivora-promos__grid">
    {% for block in section.blocks %}
      <article class="zivora-promo" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          {{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600,900,1400' }}
        {% else %}
          {% if forloop.first %}
            <img src="https://images.unsplash.com/photo-1617038260897-41a1f14a8ca0?w=1200&q=80" alt="" width="1200" height="700" loading="lazy">
          {% else %}
            <div class="zivora-promo__bg"></div>
            <img src="https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?w=1200&q=80" alt="" width="1200" height="700" loading="lazy">
          {% endif %}
        {% endif %}
        <div class="zivora-promo__copy">
          <p class="zivora-kicker">{{ block.settings.kicker }}</p>
          <h2 class="zivora-heading">{{ block.settings.heading }}</h2>
          {% if block.settings.button_label != blank %}
            <a class="zivora-btn zivora-btn--ghost" href="{{ block.settings.link | default: routes.all_products_collection_url }}">
              {{ block.settings.button_label }}
            </a>
          {% endif %}
        </div>
      </article>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Zivora promo banners",
  "tag": "section",
  "class": "zivora-promos-section",
  "enabled_on": { "templates": ["index"] },
  "settings": [],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "limit": 2,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "kicker", "label": "Kicker", "default": "New Arrivals" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Fresh Designs, Every Week" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Zivora promo banners",
      "blocks": [
        { "type": "banner", "settings": { "kicker": "New Arrivals", "heading": "Fresh Designs, Every Week", "button_label": "Shop now" } },
        { "type": "banner", "settings": { "kicker": "Shine Together", "heading": "Flat 20% Off on Jewelry Sets", "button_label": "Shop Collections" } }
      ]
    }
  ]
}
{% endschema %}
