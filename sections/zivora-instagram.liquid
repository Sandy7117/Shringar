<section class="zivora-ig zivora-section">
  <div class="zivora-wrap">
    <p class="zivora-kicker">{{ section.settings.kicker }}</p>
    <h2 class="zivora-heading">{{ section.settings.handle }}</h2>
    <div class="zivora-ig__grid">
      {% for block in section.blocks %}
        {% assign href = block.settings.link | default: section.settings.profile_url %}
        <a href="{{ href }}" {{ block.shopify_attributes }} {% if href contains 'http' %}target="_blank" rel="noopener"{% endif %}>
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '200,400,600' }}
          {% else %}
            {% liquid
              assign ig_fallbacks = 'https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?w=600&q=80,https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?w=600&q=80,https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=600&q=80,https://images.unsplash.com/photo-1611591437281-460bfbe1220a?w=600&q=80,https://images.unsplash.com/photo-1605100804763-247f67b3557e?w=600&q=80,https://images.unsplash.com/photo-1611652022419-a73b6dce8930?w=600&q=80' | split: ','
              assign ig_src = ig_fallbacks[forloop.index0]
            %}
            <img src="{{ ig_src }}" alt="" width="400" height="400" loading="lazy">
          {% endif %}
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Zivora Instagram",
  "tag": "section",
  "class": "zivora-ig-section",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Follow Us on Instagram" },
    { "type": "text", "id": "handle", "label": "Handle", "default": "@zivora.ornaments" },
    { "type": "url", "id": "profile_url", "label": "Profile URL" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "limit": 6,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Zivora Instagram",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
