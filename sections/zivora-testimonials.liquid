<zivora-quotes class="zivora-quotes zivora-section">
  <div class="zivora-wrap">
    <p class="zivora-kicker">{{ section.settings.kicker }}</p>
    <h2 class="zivora-heading">{{ section.settings.heading }}</h2>

    <div class="zivora-quotes__track">
      {% for block in section.blocks %}
        <article class="zivora-quote" {{ block.shopify_attributes }}>
          <div class="zivora-stars" aria-label="5 stars">★★★★★</div>
          <p>“{{ block.settings.quote }}”</p>
          <div class="zivora-quote__person">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 80 | image_tag: class: 'zivora-quote__avatar', loading: 'lazy' }}
            {% else %}
              <img
                class="zivora-quote__avatar"
                src="https://i.pravatar.cc/80?img={{ forloop.index | plus: 20 }}"
                alt=""
                width="36"
                height="36"
                loading="lazy"
              >
            {% endif %}
            <span>{{ block.settings.name }}{% if block.settings.location != blank %}, {{ block.settings.location }}{% endif %}</span>
          </div>
        </article>
      {% endfor %}
    </div>

    {% if section.blocks.size > 1 %}
      <div class="zivora-quotes__controls">
        <button class="zivora-icon-btn" type="button" data-prev aria-label="Previous review">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M15 5l-7 7 7 7"/></svg>
        </button>
        {% for block in section.blocks %}
          <button class="zivora-hero__dot{% if forloop.first %} is-active{% endif %}" type="button" data-dot aria-label="Review {{ forloop.index }}"></button>
        {% endfor %}
        <button class="zivora-icon-btn" type="button" data-next aria-label="Next review">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 5l7 7-7 7"/></svg>
        </button>
      </div>
    {% endif %}
  </div>
</zivora-quotes>

{% schema %}
{
  "name": "Zivora testimonials",
  "tag": "section",
  "class": "zivora-quotes-section",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "What Our Customers Say" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by Thousands" }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Review",
      "settings": [
        { "type": "text", "id": "quote", "label": "Quote", "default": "The quality is amazing for the price!" },
        { "type": "text", "id": "name", "label": "Name", "default": "Priya Sharma" },
        { "type": "text", "id": "location", "label": "Location", "default": "Mumbai" },
        { "type": "image_picker", "id": "image", "label": "Photo" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Zivora testimonials",
      "blocks": [
        { "type": "quote", "settings": { "quote": "The quality is amazing for the price!", "name": "Priya Sharma", "location": "Mumbai" } },
        { "type": "quote", "settings": { "quote": "Looks so premium, I wear them every day.", "name": "Ananya Reddy", "location": "Hyderabad" } },
        { "type": "quote", "settings": { "quote": "Packaging was beautiful. Perfect for gifting.", "name": "Meera Patel", "location": "Ahmedabad" } }
      ]
    }
  ]
}
{% endschema %}
