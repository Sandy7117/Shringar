{{ 'ugs-theme.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign slide_count = section.blocks.size
  if slide_count == 0
    assign slide_count = 3
  endif
-%}

<section class="ugs-page ugs-section ugs-section--hero">
  <div class="ugs-container">
    <ugs-hero-slider
      class="ugs-hero"
      data-interval="{{ section.settings.autoplay_speed | default: 5 | times: 1000 }}"
      {% if section.settings.autoplay %}data-autoplay="true"{% endif %}
    >
      <div class="ugs-hero__viewport" data-ugs-hero-track>
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            {%- liquid
              assign theme = block.settings.theme | default: 'image'
              assign current_slide = forloop.index
              if block.settings.image != blank
                assign slide_img = block.settings.image | image_url: width: 2400
              elsif block.settings.image_asset != blank
                capture slide_img
                  render 'ugs-asset', name: block.settings.image_asset
                endcapture
                assign slide_img = slide_img | strip
              else
                assign slide_img = blank
              endif
            -%}
            <div
              class="ugs-hero__slide ugs-hero__slide--{{ theme }}{% if forloop.first %} is-active{% endif %}"
              data-ugs-hero-slide
              {{ block.shopify_attributes }}
              {% unless forloop.first %}hidden{% endunless %}
            >
              {%- if slide_img != blank -%}
                <img
                  class="ugs-hero__media"
                  src="{{ slide_img }}"
                  alt="{{ block.settings.heading | escape }}"
                  width="1240"
                  height="300"
                  {% if forloop.first %}loading="eager"{% else %}loading="lazy"{% endif %}
                >
              {%- endif -%}
              <div class="ugs-hero__content">
                <div class="ugs-hero__progress" role="tablist" aria-label="Slide progress">
                  {%- for i in (1..slide_count) -%}
                    <button
                      type="button"
                      class="ugs-hero__bar{% if forloop.index == current_slide %} is-active{% endif %}"
                      data-ugs-hero-bar
                      data-index="{{ forloop.index0 }}"
                      aria-label="Go to slide {{ forloop.index }}"
                    >
                      <span class="ugs-hero__bar-fill"></span>
                    </button>
                  {%- endfor -%}
                </div>
                <div class="ugs-hero__copy">
                  {%- if block.settings.heading != blank -%}
                    <h2 class="ugs-hero__heading">{{ block.settings.heading }}</h2>
                  {%- endif -%}
                  {%- if block.settings.subheading != blank -%}
                    <p class="ugs-hero__subheading">{{ block.settings.subheading }}</p>
                  {%- endif -%}
                </div>
                {%- if block.settings.button_label != blank -%}
                  <a class="ugs-hero__btn" href="{{ block.settings.button_link | default: routes.all_products_collection_url }}">
                    {{ block.settings.button_label }}
                    <img src="{{ 'ugs-icon-arrow-right.svg' | asset_url }}" alt="" width="28" height="28">
                  </a>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- assign fallback_themes = 'image,blue,green' | split: ',' -%}
          {%- assign fallback_assets = 'ugs-hero-slide-1.png,ugs-hero-slide-2.png,ugs-hero-slide-3.png' | split: ',' -%}
          {%- for i in (1..3) -%}
            {%- assign idx = forloop.index0 -%}
            {%- assign current_slide = forloop.index -%}
            {%- capture slide_img -%}{% render 'ugs-asset', name: fallback_assets[idx] %}{%- endcapture -%}
            <div
              class="ugs-hero__slide ugs-hero__slide--{{ fallback_themes[idx] }}{% if forloop.first %} is-active{% endif %}"
              data-ugs-hero-slide
              {% unless forloop.first %}hidden{% endunless %}
            >
              <img
                class="ugs-hero__media"
                src="{{ slide_img | strip }}"
                alt=""
                width="1240"
                height="300"
                {% if forloop.first %}loading="eager"{% else %}loading="lazy"{% endif %}
              >
              <div class="ugs-hero__content">
                <div class="ugs-hero__progress" role="tablist" aria-label="Slide progress">
                  {%- for j in (1..3) -%}
                    <button
                      type="button"
                      class="ugs-hero__bar{% if forloop.index == current_slide %} is-active{% endif %}"
                      data-ugs-hero-bar
                      data-index="{{ forloop.index0 }}"
                      aria-label="Go to slide {{ forloop.index }}"
                    >
                      <span class="ugs-hero__bar-fill"></span>
                    </button>
                  {%- endfor -%}
                </div>
                <div class="ugs-hero__copy">
                  <h2 class="ugs-hero__heading">Premium Solar Solutions</h2>
                  <p class="ugs-hero__subheading">for Homes, Businesses & Installers!</p>
                </div>
                <a class="ugs-hero__btn" href="{{ routes.all_products_collection_url }}">
                  Order Now
                  <img src="{{ 'ugs-icon-arrow-right.svg' | asset_url }}" alt="" width="28" height="28">
                </a>
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </ugs-hero-slider>
  </div>
</section>

<script src="{{ 'ugs-hero-slider.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "UGS Hero Banner",
  "tag": "section",
  "class": "ugs-page",
  "max_blocks": 3,
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Autoplay speed",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "select",
          "id": "theme",
          "label": "Slide theme",
          "options": [
            { "value": "image", "label": "Image (slide 1)" },
            { "value": "blue", "label": "Blue (slide 2)" },
            { "value": "green", "label": "Green (slide 3)" }
          ],
          "default": "image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background image"
        },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Theme image filename"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Premium Solar Solutions"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "for Homes, Businesses & Installers!"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Order Now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "UGS Hero Banner",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "theme": "image",
            "image_asset": "ugs-hero-slide-1.png",
            "heading": "Premium Solar Solutions",
            "subheading": "for Homes, Businesses & Installers!",
            "button_label": "Order Now"
          }
        },
        {
          "type": "slide",
          "settings": {
            "theme": "blue",
            "image_asset": "ugs-hero-slide-2.png",
            "heading": "Premium Solar Solutions",
            "subheading": "for Homes, Businesses & Installers!",
            "button_label": "Order Now"
          }
        },
        {
          "type": "slide",
          "settings": {
            "theme": "green",
            "image_asset": "ugs-hero-slide-3.png",
            "heading": "Premium Solar Solutions",
            "subheading": "for Homes, Businesses & Installers!",
            "button_label": "Order Now"
          }
        }
      ]
    }
  ]
}
{% endschema %}
