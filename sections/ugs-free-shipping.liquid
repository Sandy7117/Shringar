{{ 'ugs-theme.css' | asset_url | stylesheet_tag }}

{%- liquid
  if section.settings.image != blank
    assign left_src = section.settings.image | image_url: width: 800
  else
    assign left_name = section.settings.image_asset | default: 'ugs-free-shipping-left.jpg'
    capture left_src
      render 'ugs-asset', name: left_name
    endcapture
    assign left_src = left_src | strip
  endif

  if section.settings.bg_image != blank
    assign bg_src = section.settings.bg_image | image_url: width: 1600
  else
    assign bg_name = section.settings.bg_image_asset | default: 'ugs-free-shipping-bg.jpg'
    capture bg_src
      render 'ugs-asset', name: bg_name
    endcapture
    assign bg_src = bg_src | strip
  endif
-%}

<section class="ugs-page" style="padding: 0 var(--ugs-page-pad) 80px; background: var(--ugs-n3);">
  <div class="ugs-freeship">
    <img class="ugs-freeship__media" src="{{ left_src }}" alt="" width="400" height="200" loading="lazy">
    <div class="ugs-freeship__body">
      <img class="ugs-freeship__body-bg" src="{{ bg_src }}" alt="" loading="lazy">
      {%- if section.settings.heading != blank -%}
        <h2 class="ugs-heading ugs-h3">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a
          class="ugs-btn ugs-btn--yellow-outline"
          href="{% if section.settings.phone != blank %}tel:{{ section.settings.phone | replace: ' ', '' | replace: '-', '' }}{% else %}{{ section.settings.button_link }}{% endif %}"
        >
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "UGS Free Shipping",
  "tag": "section",
  "class": "ugs-page",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Left image"
    },
    {
      "type": "text",
      "id": "image_asset",
      "label": "Left theme image filename",
      "default": "ugs-free-shipping-left.jpg"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Right background image"
    },
    {
      "type": "text",
      "id": "bg_image_asset",
      "label": "Right theme image filename",
      "default": "ugs-free-shipping-bg.jpg"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Enjoy FREE SHIPPING on Orders Over $600"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Expert Advice: 1-332-916-885 "
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone (for button tel link)",
      "default": "1-332-916-885"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link (if no phone)"
    }
  ],
  "presets": [
    {
      "name": "UGS Free Shipping"
    }
  ]
}
{% endschema %}
