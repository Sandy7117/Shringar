{{ 'ugs-theme.css' | asset_url | stylesheet_tag }}

{%- liquid
  if section.settings.image != blank
    assign cta_src = section.settings.image | image_url: width: 400
  else
    assign cta_name = section.settings.image_asset | default: 'ugs-cta-experts-5fb140.jpg'
    capture cta_src
      render 'ugs-asset', name: cta_name
    endcapture
    assign cta_src = cta_src | strip
  endif
-%}

<section class="ugs-page" style="padding: 0 var(--ugs-page-pad) 80px; background: var(--ugs-n2);">
  <div class="ugs-contact-cta">
    <div class="ugs-contact-cta__copy">
      {%- if section.settings.heading != blank -%}
        <h2 class="ugs-heading ugs-h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      <p class="ugs-contact-cta__phone">
        {{ section.settings.label }}
        {%- if section.settings.phone != blank -%}
          <strong>
            <a href="tel:{{ section.settings.phone | replace: ' ', '' | replace: '-', '' }}" style="color: inherit; text-decoration: none;">
              {{ section.settings.phone }}
            </a>
          </strong>
        {%- endif -%}
      </p>
    </div>
    <img class="ugs-contact-cta__image" src="{{ cta_src }}" alt="" width="200" height="170" loading="lazy">
  </div>
</section>

{% schema %}
{
  "name": "UGS Contact CTA",
  "tag": "section",
  "class": "ugs-page",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Have Questions About Your Solar Project?"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Phone label",
      "default": "Talk to Our Experts: "
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone",
      "default": "1-332-916-885"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_asset",
      "label": "Theme image filename",
      "default": "ugs-cta-experts-5fb140.jpg"
    }
  ],
  "presets": [
    {
      "name": "UGS Contact CTA"
    }
  ]
}
{% endschema %}
