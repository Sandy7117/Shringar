{{ 'ugs-theme.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign default_brands = 'ugs-brand-canadian.png,ugs-brand-chargepoint.png,ugs-brand-sungrow.png,ugs-brand-eg4.png,ugs-brand-longi.png,ugs-brand-sungrow.png' | split: ','
-%}

<section class="ugs-page" style="padding: 0 var(--ugs-page-pad) 40px; background: var(--ugs-n3);">
  <div class="ugs-brands">
    {%- if section.settings.title != blank -%}
      <h2 class="ugs-heading ugs-h2 ugs-brands__title">{{ section.settings.title }}</h2>
    {%- endif -%}
    <div class="ugs-brands__track-wrap">
      <div class="ugs-brands__track">
        {%- for i in (1..2) -%}
          {%- for block in section.blocks -%}
            {%- liquid
              if block.settings.logo != blank
                assign logo_src = block.settings.logo | image_url: width: 400
              else
                assign logo_name = block.settings.logo_asset | default: default_brands[forloop.index0]
                capture logo_src
                  render 'ugs-asset', name: logo_name
                endcapture
                assign logo_src = logo_src | strip
              endif
            -%}
            <div class="ugs-brands__item" {% if i == 1 %}{{ block.shopify_attributes }}{% endif %}>
              {%- if logo_src != blank -%}
                <img src="{{ logo_src }}" alt="{{ block.settings.title | escape }}" width="180" height="60" loading="lazy">
              {%- else -%}
                <span>{{ block.settings.title }}</span>
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "UGS Brands",
  "tag": "section",
  "class": "ugs-page",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Brands We Carry"
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "text",
          "id": "logo_asset",
          "label": "Theme logo filename"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Brand name",
          "default": "Brand"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "UGS Brands",
      "blocks": [
        {
          "type": "brand",
          "settings": {
            "title": "Canadian Solar",
            "logo_asset": "ugs-brand-canadian.png"
          }
        },
        {
          "type": "brand",
          "settings": {
            "title": "ChargePoint",
            "logo_asset": "ugs-brand-chargepoint.png"
          }
        },
        {
          "type": "brand",
          "settings": {
            "title": "Sungrow",
            "logo_asset": "ugs-brand-sungrow.png"
          }
        },
        {
          "type": "brand",
          "settings": {
            "title": "EG4",
            "logo_asset": "ugs-brand-eg4.png"
          }
        },
        {
          "type": "brand",
          "settings": {
            "title": "LONGi",
            "logo_asset": "ugs-brand-longi.png"
          }
        },
        {
          "type": "brand",
          "settings": {
            "title": "Sungrow",
            "logo_asset": "ugs-brand-sungrow.png"
          }
        }
      ]
    }
  ]
}
{% endschema %}
