    "ugs_faq": {
      "type": "ugs-faq",
      "blocks": {
        "q1": {
          "type": "faq",
          "settings": {
            "question": "Do you offer nationwide shipping?",
            "answer": "Yes. We ship solar panels, inverters, batteries, EV chargers, and accessories across the United States. Enjoy free shipping on qualifying orders over $600."
          }
        },
        "q2": {
          "type": "faq",
          "settings": {
            "question": "Which solar brands do you carry?",
            "answer": "We carry Tier-1 brands including Canadian Solar, LONGi, Sungrow, ChargePoint, EG4, and more."
          }
        },
        "q3": {
          "type": "faq",
          "settings": {
            "question": "Can you help me choose the right products?",
            "answer": "Absolutely. Our U.S.-based solar experts can help you select panels, inverters, batteries, and complete kits for residential or commercial projects."
          }
        },
        "q4": {
          "type": "faq",
          "settings": {
            "question": "Do you offer wholesale pricing?",
            "answer": "Yes. Installers, contractors, and dealers can access competitive wholesale pricing and volume discounts through our dealer program."
